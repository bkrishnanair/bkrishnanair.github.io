{
  "name": "balakrishna-portfolio-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "npm run dev",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir .ssr && node scripts/prerender.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "preview": "node scripts/preview.mjs",
    "predeploy": "npm test",
    "deploy": "gh-pages -d dist --dotfiles",
    "prebuild": "node scripts/assets.mjs",
    "format": "prettier --write src scripts tests index.html vite.config.js package.json",
    "format:check": "prettier --check src scripts tests index.html vite.config.js package.json"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.1",
    "cheerio": "^1.1.2",
    "gh-pages": "^6.3.0",
    "prettier": "3.9.8",
    "sharp": "0.35.4",
    "vite": "8.3.0"
  }
}
